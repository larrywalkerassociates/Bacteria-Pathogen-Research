library(pROC)
roc_obj <- roc(df_2$pathogen_binary, fitted(test1))
auc(roc_obj) #AUC = 0.7149
# AUC ~0.5 → no predictive ability
# AUC >0.7 → useful
# AUC >0.8 → strong
#compare to single variable
m1 <- glm(pathogen_binary ~ crassphage, family = binomial, data = df_2)
roc_obj_m1 <- roc(df_2$pathogen_binary, fitted(m1))
auc(roc_obj_m1)
summary(test1)
summary(m1)
#3) compare models (single vs multiple indicators)
AIC(test1, m1)
auc(test1, m1)
auc(roc_obj, roc_obj_m1)
auc(roc_obj_m1)
#4) test for any signal at all
#likelihood ratio test?:
anova(test1, test = "Chisq")
