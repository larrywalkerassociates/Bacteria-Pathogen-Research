ifelse(is.na(adv), NA, adv))) |>
dplyr::mutate(pathogens_add = rowSums(across(norog1_rev:adv_rev), na.rm = TRUE)) |>
dplyr::mutate(pathogens_add = ifelse((is.na(norog1_rev) & is.na(norog2_rev) & is.na(adv_rev)), NA, pathogens_add)) |>
